	SECTION	"Code",CODE[$1000]

zero	EQU	0

	MC68000

	move.l	0(a1),d0		; 2011
	move.l	zero(a1),d0		; 2011
	move.l	(0,a1),d0		; 2011
	move.l	0.w(a1),d0		; 2029 0000
	move.l	4(a1),d0		; 2029 0004
	movep.w	0(a0),d1		; 0308 0000
	lea	0(a3),a4		; 49d3

	MC68030

	move.l	0(a1),d0		; 2011
	move.l	(zero,a1),d0		; 2011
	move.l	(4,a1),d0		; 2029 0004
	movep.l	d1,zero(a2)		; 03ca 0000
